generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  username  String    @unique
  password  String
  role      String    @default("cashier")
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id         Int        @id @default(autoincrement())
  name       String
  price      Float
  stock      Int        @default(0)
  barcode    String?    @unique
  categoryId Int
  category   Category   @relation(fields: [categoryId], references: [id])
  createdAt  DateTime   @default(now())
  saleItems  SaleItem[]
}

model Sale {
  id        Int        @id @default(autoincrement())
  total     Float
  discount  Float      @default(0)
  cash      Float
  change    Float
  userId    Int
  createdAt DateTime   @default(now())
  items     SaleItem[]
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  price     Float
  total     Float
  sale      Sale    @relation(fields: [saleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}